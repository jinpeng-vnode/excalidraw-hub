---
// src/components/TemplateCard.astro — 模板卡片（列表页用）
import Icon from './Icon.astro'

interface Props {
  title: string
  description: string
  slug: string
  category: string
  elements?: any[]
}

const { title, description, slug, category, elements = [] } = Astro.props
// 生成简易 SVG 预览（修复 #13: 模板预览图为空白占位符）
const hasElements = elements && elements.length > 0
---

<a href={`/template/${slug}`} class="block group rounded-xl border border-gray-200 overflow-hidden hover:shadow-lg transition-shadow">
  <div class="aspect-video bg-gray-50 flex items-center justify-center p-4">
    {hasElements ? (
      <svg viewBox="100 0 350 550" class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
        {elements.map((el: any) => {
          if (el.type === 'rectangle') return <rect x={el.x} y={el.y} width={el.width} height={el.height} fill={el.backgroundColor || '#e3e3e3'} stroke={el.strokeColor || '#333'} stroke-width="2" rx="4" />
          if (el.type === 'diamond') return <polygon points={`${el.x + el.width/2},${el.y} ${el.x + el.width},${el.y + el.height/2} ${el.x + el.width/2},${el.y + el.height} ${el.x},${el.y + el.height/2}`} fill={el.backgroundColor || '#e3e3e3'} stroke={el.strokeColor || '#333'} stroke-width="2" />
          if (el.type === 'ellipse') return <ellipse cx={el.x + el.width/2} cy={el.y + el.height/2} rx={el.width/2} ry={el.height/2} fill={el.backgroundColor || '#e3e3e3'} stroke={el.strokeColor || '#333'} stroke-width="2" />
          return null
        })}
      </svg>
    ) : (
      <Icon name={category || 'clipboard'} size={48} class="text-gray-300" />
    )}
  </div>
  <div class="p-4">
    <span class="text-xs text-brand font-medium uppercase">{category}</span>
    <h3 class="font-semibold text-gray-900 mt-1 group-hover:text-brand transition-colors">{title}</h3>
    <p class="text-sm text-gray-500 mt-1 line-clamp-2">{description}</p>
  </div>
</a>
