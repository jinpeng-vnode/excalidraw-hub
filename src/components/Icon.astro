---
// src/components/Icon.astro — Lucide SVG 图标组件
import { getIconPath } from '../data/categories'

interface Props {
  name: string
  size?: number
  class?: string
}

const { name, size = 24, class: className = '' } = Astro.props
const path = getIconPath(name)
---

<svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={className}>
  <path d={path} />
</svg>
