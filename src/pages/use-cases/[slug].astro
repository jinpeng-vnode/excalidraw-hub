---
// src/pages/use-cases/[slug].astro — 用途落地页（Programmatic SEO）
import LandingLayout from '../../layouts/LandingLayout.astro'
import TemplateCard from '../../components/TemplateCard.astro'
import Icon from '../../components/Icon.astro'
import { getCollection } from 'astro:content'
import { useCases } from '../../data/use-cases'
import type { SeoMeta } from '../../utils/seo'

export function getStaticPaths() {
  return useCases.map((uc) => ({
    params: { slug: uc.slug },
    props: { useCase: uc },
  }))
}

const { useCase } = Astro.props
const allTemplates = await getCollection('templates')
const relatedTemplates = allTemplates.filter((t) => t.data.category === useCase.category)

const seo: SeoMeta = {
  title: `${useCase.title} - Excalidraw Hub`,
  description: useCase.description,
  keywords: useCase.keywords,
  ogType: 'website',
  hreflang: [
    { lang: 'en', url: `https://excalidraw-hub.com/use-cases/${useCase.slug}` },
    { lang: 'zh', url: `https://excalidraw-hub.com/zh/use-cases/${useCase.slug}` },
  ],
  schema: {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: useCase.title,
    description: useCase.description,
    applicationCategory: 'DesignApplication',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
}
---

<LandingLayout seo={seo}>
  <!-- 面包屑 -->
  <nav class="text-sm text-gray-500 mb-4">
    <a href="/" class="hover:text-brand">Home</a> /
    <a href="/use-cases/free-online-whiteboard" class="hover:text-brand">Use Cases</a> /
    <span class="text-gray-900">{useCase.title}</span>
  </nav>

  <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">{useCase.title}</h1>

  <!-- 描述 -->
  <p class="text-lg text-gray-600 mb-8">{useCase.content}</p>

  <!-- CTA -->
  <a href="/editor" class="inline-block bg-brand text-white px-8 py-3 rounded-lg text-lg font-medium hover:bg-brand-dark transition-colors mb-12">
    Start Creating Free →
  </a>

  <!-- 功能列表 -->
  <h2 class="text-2xl font-bold text-gray-900 mb-4">Key Features</h2>
  <ul class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-12">
    {useCase.features.map((f: string) => (
      <li class="flex items-center gap-2 text-gray-700">
        <Icon name="check" size={16} class="text-green-500" /> {f}
      </li>
    ))}
  </ul>

  <!-- 相关模板 -->
  {relatedTemplates.length > 0 && (
    <section class="mb-12">
      <h2 class="text-2xl font-bold text-gray-900 mb-4">Related Templates</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {relatedTemplates.map((tpl) => (
          <TemplateCard title={tpl.data.title} description={tpl.data.description} slug={tpl.data.slug} category={tpl.data.category} />
        ))}
      </div>
    </section>
  )}

  <!-- 内部链接（SEO 互链） -->
  <section class="border-t pt-8">
    <h2 class="text-xl font-bold text-gray-900 mb-4">Explore More Tools</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
      {useCases.filter(uc => uc.slug !== useCase.slug).slice(0, 6).map((uc) => (
        <a href={`/use-cases/${uc.slug}`} class="text-brand hover:underline text-sm">
          {uc.title}
        </a>
      ))}
    </div>
  </section>
</LandingLayout>
