---
// src/pages/use-cases/[slug].astro — 用途落地页（如 flowchart-maker）
import LandingLayout from '../../layouts/LandingLayout.astro'
import TemplateCard from '../../components/TemplateCard.astro'
import { getCollection } from 'astro:content'
import type { SeoMeta } from '../../utils/seo'

export function getStaticPaths() {
  const useCases = [
    {
      slug: 'flowchart-maker',
      title: 'Free Online Flowchart Maker',
      description: 'Create professional flowcharts and process diagrams online for free. No signup required. Export as PNG or SVG.',
      keywords: ['flowchart maker', 'free flowchart tool', 'online flowchart', 'process diagram maker'],
      category: 'flowchart',
      content: 'Excalidraw Hub provides a powerful yet simple flowchart maker that lets you create professional process diagrams in minutes. Whether you need to document a business process, design a software architecture, or plan a project workflow, our tool has you covered.',
      features: ['Drag-and-drop interface', 'Pre-built flowchart shapes', 'Export to PNG, SVG, or clipboard', 'No account required', 'Works offline'],
    },
    {
      slug: 'mind-map-tool',
      title: 'Free Online Mind Map Tool',
      description: 'Brainstorm and organize ideas with our free online mind map tool. Create beautiful mind maps instantly.',
      keywords: ['mind map tool', 'free mind map', 'online brainstorming', 'idea organizer'],
      category: 'mindmap',
      content: 'Organize your thoughts and ideas visually with Excalidraw Hub mind map tool. Perfect for brainstorming sessions, project planning, and study notes. Our hand-drawn style makes your mind maps unique and engaging.',
      features: ['Infinite canvas', 'Hand-drawn aesthetic', 'Real-time collaboration', 'Multiple export formats', 'Template library'],
    },
    {
      slug: 'wireframe-tool',
      title: 'Free Online Wireframe Tool',
      description: 'Design web and mobile wireframes online for free. Quick prototyping with no learning curve.',
      keywords: ['wireframe tool', 'free wireframe', 'UI mockup tool', 'prototype design'],
      category: 'wireframe',
      content: 'Design web and mobile wireframes quickly with Excalidraw Hub. Our sketch-style wireframes are perfect for early-stage design discussions. Share ideas with your team without spending hours on pixel-perfect mockups.',
      features: ['UI component library', 'Responsive design templates', 'Quick prototyping', 'Team sharing', 'Version history'],
    },
  ]
  return useCases.map((uc) => ({
    params: { slug: uc.slug },
    props: { useCase: uc },
  }))
}

const { useCase } = Astro.props
const allTemplates = await getCollection('templates')
const relatedTemplates = allTemplates.filter((t) => t.data.category === useCase.category)

const seo: SeoMeta = {
  title: `${useCase.title} - Excalidraw Hub`,
  description: useCase.description,
  keywords: useCase.keywords,
  ogType: 'website',
  hreflang: [
    { lang: 'en', url: `https://excalidraw-hub.com/use-cases/${useCase.slug}` },
    { lang: 'zh', url: `https://excalidraw-hub.com/zh/use-cases/${useCase.slug}` },
  ],
  schema: {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: useCase.title,
    description: useCase.description,
    applicationCategory: 'DesignApplication',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
}
---

<LandingLayout seo={seo}>
  <!-- 面包屑 -->
  <nav class="text-sm text-gray-500 mb-4">
    <a href="/" class="hover:text-brand">Home</a> /
    <span class="text-gray-900">{useCase.title}</span>
  </nav>

  <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">{useCase.title}</h1>

  <!-- 描述 -->
  <p class="text-lg text-gray-600 mb-8">{useCase.content}</p>

  <!-- CTA -->
  <a href="/editor" class="inline-block bg-brand text-white px-8 py-3 rounded-lg text-lg font-medium hover:bg-brand-dark transition-colors mb-12">
    Start Creating →
  </a>

  <!-- 功能列表 -->
  <h2 class="text-2xl font-bold text-gray-900 mb-4">Features</h2>
  <ul class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-12">
    {useCase.features.map((f: string) => (
      <li class="flex items-center gap-2 text-gray-700">
        <span class="text-green-500">✓</span> {f}
      </li>
    ))}
  </ul>

  <!-- 相关模板 -->
  {relatedTemplates.length > 0 && (
    <section>
      <h2 class="text-2xl font-bold text-gray-900 mb-4">Related Templates</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {relatedTemplates.map((tpl) => (
          <TemplateCard title={tpl.data.title} description={tpl.data.description} slug={tpl.data.slug} category={tpl.data.category} />
        ))}
      </div>
    </section>
  )}
</LandingLayout>
