---
// src/pages/index.astro — 首页（工具介绍 + 热门模板）
import BaseLayout from '../layouts/BaseLayout.astro'
import TemplateCard from '../components/TemplateCard.astro'
import { t } from '../i18n/utils'
import { buildAppSchema } from '../utils/seo'
import type { SeoMeta } from '../utils/seo'

const locale = 'en'

const seo: SeoMeta = {
  title: t(locale, 'site.title'),
  description: t(locale, 'site.description'),
  keywords: ['excalidraw', 'whiteboard', 'online whiteboard', 'flowchart maker', 'diagram tool', 'free whiteboard'],
  ogType: 'website',
  hreflang: [
    { lang: 'en', url: 'https://excalidraw-hub.com/' },
    { lang: 'zh', url: 'https://excalidraw-hub.com/zh/' },
  ],
  schema: buildAppSchema(),
}

// 热门模板（硬编码示例，后续从 Content Collections 读取）
const popularTemplates = [
  { title: 'Basic Flowchart', description: 'A simple flowchart template for process documentation', slug: 'flowchart-basic', category: 'flowchart' },
  { title: 'Project Mind Map', description: 'Organize your project ideas with this mind map template', slug: 'mindmap-project', category: 'mindmap' },
  { title: 'Wireframe Kit', description: 'UI wireframe components for web and mobile design', slug: 'wireframe-kit', category: 'wireframe' },
]
---

<BaseLayout seo={seo}>
  <!-- Hero 区域 -->
  <section class="bg-gradient-to-b from-brand/5 to-white py-20 text-center">
    <div class="max-w-3xl mx-auto px-4">
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
        {t(locale, 'home.hero')}
      </h1>
      <p class="text-lg text-gray-600 mb-8">
        {t(locale, 'home.heroSub')}
      </p>
      <a href="/editor" class="inline-block bg-brand text-white px-8 py-3 rounded-lg text-lg font-medium hover:bg-brand-dark transition-colors">
        {t(locale, 'home.cta')}
      </a>
    </div>
  </section>

  <!-- 热门模板 -->
  <section class="max-w-7xl mx-auto px-4 py-16">
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-2xl font-bold text-gray-900">{t(locale, 'home.templates')}</h2>
      <a href="/templates" class="text-brand hover:underline">{t(locale, 'home.viewAll')} →</a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {popularTemplates.map((tpl) => (
        <TemplateCard {...tpl} />
      ))}
    </div>
  </section>
</BaseLayout>
