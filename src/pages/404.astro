---
// src/pages/404.astro — 自定义404页面（修复 #14）
import BaseLayout from '../layouts/BaseLayout.astro'
import type { SeoMeta } from '../utils/seo'

const seo: SeoMeta = {
  title: '404 - Page Not Found | Excalidraw Hub',
  description: 'The page you are looking for does not exist.',
  keywords: [],
}
---

<BaseLayout seo={seo}>
  <section class="max-w-2xl mx-auto px-4 py-24 text-center">
    <h1 class="text-6xl font-bold text-gray-300 mb-4">404</h1>
    <p class="text-xl text-gray-600 mb-8">Page not found</p>
    <p class="text-gray-500 mb-8">The page you're looking for doesn't exist or has been moved.</p>
    <div class="flex gap-4 justify-center">
      <a href="/" class="px-6 py-3 bg-brand text-white rounded-lg hover:bg-brand-dark transition-colors">Go Home</a>
      <a href="/editor" class="px-6 py-3 border border-gray-300 rounded-lg hover:border-brand hover:text-brand transition-colors">Open Editor</a>
    </div>
  </section>
</BaseLayout>
