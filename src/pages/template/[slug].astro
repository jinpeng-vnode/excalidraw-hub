---
// src/pages/template/[slug].astro — 模板详情/落地页（Programmatic SEO 核心）
import LandingLayout from '../../layouts/LandingLayout.astro'
import Icon from '../../components/Icon.astro'
import { getCollection } from 'astro:content'
import { getCategoryById } from '../../data/categories'
import type { SeoMeta } from '../../utils/seo'

export async function getStaticPaths() {
  const templates = await getCollection('templates')
  return templates.map((tpl) => ({
    params: { slug: tpl.data.slug },
    props: { template: tpl.data },
  }))
}

const { template } = Astro.props
const category = getCategoryById(template.category)

const seo: SeoMeta = {
  title: template.seoTitle,
  description: template.seoDescription,
  keywords: template.keywords,
  ogType: 'article',
  hreflang: [
    { lang: 'en', url: `https://draw.todonot.com/template/${template.slug}` },
    { lang: 'zh', url: `https://draw.todonot.com/zh/template/${template.slug}` },
  ],
  schema: {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: template.title,
    description: template.seoDescription,
    applicationCategory: 'DesignApplication',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
}
---

<LandingLayout seo={seo}>
  <!-- 面包屑 -->
  <nav class="text-sm text-gray-500 mb-4">
    <a href="/" class="hover:text-brand">Home</a> /
    <a href="/templates" class="hover:text-brand">Templates</a> /
    <span class="text-gray-900">{template.title}</span>
  </nav>

  <!-- 标题 -->
  <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">{template.seoTitle}</h1>

  <!-- 分类标签 -->
  {category && (
    <span class="inline-flex items-center gap-1 px-3 py-1 bg-brand/10 text-brand rounded-full text-sm mb-6">
      <Icon name={category.icon} size={14} /> {category.name}
    </span>
  )}

  <!-- 模板预览（修复 #13: 从 excalidrawData 渲染 SVG 预览） -->
  <div class="aspect-video bg-gray-50 rounded-xl border border-gray-200 flex items-center justify-center mb-8 p-6">
    {template.excalidrawData?.elements?.length > 0 ? (
      <svg viewBox="100 0 350 550" class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
        {template.excalidrawData.elements.map((el: any) => {
          if (el.type === 'rectangle') return <rect x={el.x} y={el.y} width={el.width} height={el.height} fill={el.backgroundColor || '#e3e3e3'} stroke={el.strokeColor || '#333'} stroke-width="2" rx="4" />
          if (el.type === 'diamond') return <polygon points={`${el.x + el.width/2},${el.y} ${el.x + el.width},${el.y + el.height/2} ${el.x + el.width/2},${el.y + el.height} ${el.x},${el.y + el.height/2}`} fill={el.backgroundColor || '#e3e3e3'} stroke={el.strokeColor || '#333'} stroke-width="2" />
          if (el.type === 'ellipse') return <ellipse cx={el.x + el.width/2} cy={el.y + el.height/2} rx={el.width/2} ry={el.height/2} fill={el.backgroundColor || '#e3e3e3'} stroke={el.strokeColor || '#333'} stroke-width="2" />
          return null
        })}
      </svg>
    ) : (
      <Icon name="clipboard" size={64} class="text-gray-300" />
    )}
  </div>

  <!-- 描述文案（SEO 内容） -->
  <div class="prose max-w-none mb-8">
    <p>{template.description}</p>
    <h2>How to Use This Template</h2>
    <ol>
      <li>Click "Use This Template" to open it in the editor</li>
      <li>Customize the content, colors, and layout</li>
      <li>Export as PNG, SVG, or share a link</li>
    </ol>
  </div>

  <!-- CTA 按钮 -->
  <a href={`/editor?template=${template.slug}`} class="inline-block bg-brand text-white px-8 py-3 rounded-lg text-lg font-medium hover:bg-brand-dark transition-colors">
    Use This Template →
  </a>

  <!-- 标签 -->
  <div class="mt-8 flex gap-2 flex-wrap">
    {template.tags.map((tag: string) => (
      <span class="px-2 py-1 bg-gray-100 text-gray-600 rounded text-sm">{tag}</span>
    ))}
  </div>
</LandingLayout>
